generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// Identity & Organizations
// ---------------------------------------------------------

model Company {
  id        String          @id @default(uuid())
  name      String
  locations Location[]
  users     User[]
  setting   CompanySetting?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  deletedAt DateTime?
}

model Location {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  code      String // e.g., BP-NJ
  type      String  @default("Warehouse") // Warehouse, Showroom, Consignment, Office

  // Address + contact
  line1             String?
  line2             String?
  city              String?
  region            String?
  postalCode        String?
  country           String?
  phone             String?
  fax               String?
  defaultPriceLevel String?

  inventoryItems InventoryItem[]
  userLocations  UserLocation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
}

model User {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  email         String         @unique
  passwordHash  String
  role          String // e.g., ADMIN, MANAGER, SALES
  userLocations UserLocation[]

  // The business entity this login acts AS: a SALES user → their Associate Party,
  // a VENDOR user → their Vendor Party. ADMIN logins leave this null.
  partyId String? @unique
  party   Party?  @relation("UserParty", fields: [partyId], references: [id])

  // Per-user dashboard layout: ordered list of widget keys the user has pinned.
  dashboardLayout Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model UserLocation {
  userId     String
  locationId String
  user       User     @relation(fields: [userId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@id([userId, locationId])
}

// ---------------------------------------------------------
// CRM: Parties (Unified Entity)
// ---------------------------------------------------------

model Party {
  id                   String    @id @default(uuid())
  type                 String // CUSTOMER, SUPPLIER, VENDOR, ASSOCIATE
  systemId             String?   @unique // Auto-generated ID (e.g. REP-4041, S-001, V-001, C-001)
  name                 String // display / trading name
  legalName            String? // registered legal entity name
  website              String?
  status               String    @default("ACTIVE") // ACTIVE, PREFERRED, ON_HOLD, INACTIVE
  notes                String?
  email                String?
  phone                String?
  address              String? // legacy free-text; structured addresses live in Address[]
  contactPerson        String?
  // Supplier-specific
  subType              String? // Supplier: Quarry/Fabricator/Distributor. Customer: Fabricator/Designer/Contractor/Retail
  originCountry        String?
  materialCategories   String[]  @default([]) // e.g. ["Marble","Granite"] supplied
  paymentTerms         String? // Net 30, Net 60, Pre-Pay
  incoterms            String? // FOB Genoa, DDP Boston, CIF Miami
  creditLimit          Float     @default(0.0)
  currency             String    @default("USD")
  taxId                String? // VAT / tax / business registration number
  leadTimeDays         Int? // typical production lead time
  minOrderValue        Float? // minimum order value
  remittanceInfo       String? // bank / IBAN / SWIFT remittance details
  certifications       String? // e.g. CE, ISO 9001
  // Vendor-specific
  serviceType          String? // Ocean Freight, Inland Logistics, Customs & Tariffs
  serviceArea          String? // lanes / regions served
  rateBasis            String? // Per Container, Per Mile, Flat
  insurancePolicy      String? // policy number + expiry
  licenseNumber        String? // MC/DOT, FMC, customs-broker license
  // Customer-specific
  taxExempt            Boolean   @default(false)
  resaleCertNumber     String?
  priceTier            String? // Standard, Preferred, Wholesale
  source               String? // how the customer was acquired
  // Customer — identity & classification
  dba                  String? // "Doing Business As" / print name on documents
  referredBy           String? // referral source / referring party
  parentCustomerId     String? // corporate parent for multi-location customers
  parentCustomer       Party?    @relation("CustomerHierarchy", fields: [parentCustomerId], references: [id])
  childCustomers       Party[]   @relation("CustomerHierarchy")
  multiLocation        Boolean   @default(false)
  genericCustomer      Boolean   @default(false) // walk-in / cash account
  // Customer — extra contact channels
  secondaryPhone       String?
  mobilePhone          String?
  fax                  String?
  accountingEmail      String? // AP/AR inbox for invoices & statements
  // Customer — tax & compliance
  taxExemptReason      String?
  salesTaxCode         String? // tax jurisdiction / rate code
  exemptCertExpiry     DateTime?
  // Customer — sales & fulfillment
  defaultFulfillment   String?
  customerSince        DateTime?
  // Customer — accounting controls
  poRequired           Boolean   @default(false) // a PO is required to process sales orders
  applyFinanceCharges  Boolean   @default(false)
  docDeliveryPref      String? // preferred document delivery channel
  gracePeriodDays      Int? // days after due before past-due lock
  holdDays             Int? // days an order may sit on hold
  // Customer — credit controls
  creditLockExempt     Boolean   @default(false)
  salesAlertNote       String? // soft warning surfaced to sales
  salesLockNote        String? // hard stop reason surfaced to sales
  // Customer — instructions
  deliveryInstructions String?
  collectionNotes      String?
  copyNotesToOrders    Boolean   @default(false)
  // Associate-specific
  role                 String? // Senior Sales Rep, Branch Manager, Sales Rep
  baseLocation         String? // display label e.g. "Maryland Hub"
  commissionRate       String? // e.g. "5%"
  salesTargetAnnual    Float? // personal annual sales quota; editable by the rep or an admin
  employeeId           String?
  startDate            DateTime?
  territory            String?
  // Customer → assigned sales rep (self-relation Party→Party)
  assignedAssociateId  String?
  assignedAssociate    Party?    @relation("CustomerRep", fields: [assignedAssociateId], references: [id])
  repCustomers         Party[]   @relation("CustomerRep")
  // Denormalized metrics
  totalPurchased       Float     @default(0.0)
  totalSold            Float     @default(0.0)
  balanceDue           Float     @default(0.0)

  addresses Address[]
  contacts  Contact[]

  purchaseOrders       PurchaseOrder[] // As Supplier
  salesOrders          SalesOrder[]    @relation("CustomerSalesOrders")
  associateSalesOrders SalesOrder[]    @relation("AssociateSalesOrders")
  vendorInvoices       VendorInvoice[]

  customerOpportunities  Opportunity[] @relation("CustomerOpportunities")
  associateOpportunities Opportunity[] @relation("AssociateOpportunities")

  // The login account that acts as this party (if any).
  userAccount User? @relation("UserParty")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
}

model Address {
  id         String  @id @default(uuid())
  partyId    String
  party      Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  kind       String  @default("PRIMARY") // PRIMARY, BILLING, SHIPPING, WAREHOUSE
  line1      String
  line2      String?
  city       String
  region     String? // state / province
  postalCode String?
  county     String? // US county (used on bill-to / ship-to)
  country    String
  isPrimary  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([partyId])
}

model Contact {
  id      String  @id @default(uuid())
  partyId String
  party   Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  kind    String  @default("GENERAL") // GENERAL, SALES, AP, DISPATCH, LOGISTICS
  name    String
  title   String?
  email   String?
  phone   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([partyId])
}

// ---------------------------------------------------------
// Product Catalog
// ---------------------------------------------------------

model Product {
  id           String @id @default(uuid())
  sku          String @unique
  name         String
  materialType String // Quartzite, Granite, Marble
  finish       String // Polished, Honed, Leathered
  baseColor    String // Sea Green, Deep Purple
  attributes   Json? // { "veining": "Heavy", "bookmatched": true }

  // Catalog hierarchy (Products Master List)
  productType  String  @default("SLAB") // SLAB, SINK, TILE, PADS, A-FRAME
  category     String? // GRANITE, MARBLE, QUARTZITE, QUARTZ, SINKS, ...
  subCategory  String?
  productGroup String? // Exotics, Premium, Semi-precious, Standard
  altName      String? // Generic / alternate display name
  genericSku   String? // Generic SKU for cross-reference

  thickness           String? // 2cm, 3cm
  originCountry       String?
  retailPricePerSf    Float?
  minPricePerSf       Float?
  avgCostPerSf        Float?
  approvedSupplierIds String[] @default([]) // Party ids of approved suppliers

  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------
// Inventory & The Material Passport
// ---------------------------------------------------------

model InventoryItem {
  id           String @id @default(uuid())
  uniqueSlabId String @unique // e.g., BP-NJ-2026-00001
  barcode      String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])

  presentLocationId String
  location          Location @relation(fields: [presentLocationId], references: [id])

  bin    String?
  status String // ORDERED, RECEIVED, AVAILABLE, ON_HOLD, COMMITTED, SOLD, WRITTEN_OFF

  holdReason String? // why the slab is currently ON_HOLD (cleared on release)

  // Grouping
  lotNumber String?
  bundleId  String?

  movements StockMovement[]
  photos    SlabPhoto[]

  // Dimensions
  lengthInches Float
  widthInches  Float
  totalSf      Float

  // Sacred Financials
  costFob         Float?
  costApportioned Float?
  costLanded      Float?

  // Remnants
  parentItemId String?
  parentItem   InventoryItem?  @relation("RemnantChain", fields: [parentItemId], references: [id])
  remnants     InventoryItem[] @relation("RemnantChain")

  // Relationships
  poLineItemId String?     @unique
  poLineItem   POLineItem? @relation(fields: [poLineItemId], references: [id])

  soLineItem SOLineItem?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Audit trail of every operational change to a slab (transfer / hold / release / write-off).
model StockMovement {
  id              String        @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  type            String // TRANSFER, HOLD, RELEASE, WRITE_OFF, RECONCILIATION_ADJUSTMENT
  fromLocationId  String?
  toLocationId    String?
  fromStatus      String?
  toStatus        String?
  reason          String?
  note            String?
  byUserId        String?
  byRole          String?
  createdAt       DateTime      @default(now())

  // Traceability from a retroactive cost/qty correction back to the delta that caused it.
  reconciliationDeltaId String?

  @@index([inventoryItemId])
}

// Staff-captured photos of the physical slab (opt-in, multi-photo). Stored on
// local disk for now via src/lib/storage.ts; storageKey is the seam for a
// future move to object storage.
model SlabPhoto {
  id               String        @id @default(uuid())
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  storageKey       String
  originalName     String?
  sortOrder        Int           @default(0)
  uploadedByUserId String?
  uploadedByRole   String?
  createdAt        DateTime      @default(now())

  @@index([inventoryItemId])
}

// ---------------------------------------------------------
// Procurement Pipeline
// ---------------------------------------------------------

model PurchaseOrder {
  id         String @id @default(uuid())
  poNumber   String @unique
  supplierId String
  supplier   Party  @relation(fields: [supplierId], references: [id])
  status     String @default("ISSUED") // PENDING_APPROVAL, APPROVED, ISSUED, FULFILLED

  // Ordered material (single-material PO for this app)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  orderedSlabs Int      @default(0)
  unitCost     Float    @default(0.0) // supplier material price, FOB $/sf

  // Per-leg logistics charges entered at PO creation; apportioned into landed cost on receipt
  oceanCost   Float @default(0.0)
  customsCost Float @default(0.0)
  inlandCost  Float @default(0.0)

  // Logistics pipeline
  logisticsStatus   String    @default("PRODUCTION") // PRODUCTION, ON_WATER, CUSTOMS, INLAND_TRANSIT, RECEIVED
  oceanVendorId     String? // Party id of vendor, or "SUPPLIER_COVERED"
  customsVendorId   String?
  inlandVendorId    String?
  containerId       String?
  eta               String?
  estimatedDelivery DateTime? // ETA captured at PO creation; drives on-track / due-soon / overdue status
  receiptNumber     String? // Goods-receipt / packing-slip number entered when the PO is closed (offline doc ref)
  destinationHub    String?
  documentRefs      String[]  @default([])
  issuedAt          DateTime  @default(now())
  ledgerHash        String?

  poLineItems POLineItem[]

  reconciliationCases  ReconciliationCase[]
  reconciliationDeltas ReconciliationDelta[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([logisticsStatus])
}

model POLineItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  expectedSf   Float
  expectedCost Float

  inventoryItem InventoryItem?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------
// Sales Pipeline & Opportunities
// ---------------------------------------------------------

model Opportunity {
  id   String @id @default(uuid())
  name String // e.g., "Marriott Downtown Reno"

  // Lead / Customer Info (can be new or existing)
  customerId String?
  customer   Party?  @relation("CustomerOpportunities", fields: [customerId], references: [id])
  leadName   String? // Used if customer doesn't exist yet
  leadEmail  String?
  leadPhone  String?

  // Metrics
  amount      Float  @default(0.0)
  probability Int    @default(0) // e.g., 50 for 50%
  status      String // LEAD, QUOTED, NEGOTIATION, CLOSED_WON, CLOSED_LOST

  // Origin & Assignment
  source      String // MANUAL, WEBSITE
  associateId String?
  associate   Party?  @relation("AssociateOpportunities", fields: [associateId], references: [id])

  expectedCloseDate DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model SalesOrder {
  id           String   @id @default(uuid())
  soNumber     String   @unique
  customerId   String?
  customer     Party?   @relation("CustomerSalesOrders", fields: [customerId], references: [id])
  customerName String? // project label, e.g. "John Smith - Kitchen Remodel"
  associateId  String?
  associate    Party?   @relation("AssociateSalesOrders", fields: [associateId], references: [id])
  status       String   @default("PLACED") // PLACED, COMPLETED, CANCELLED
  receiptRef   String?
  placedAt     DateTime @default(now())

  soLineItems SOLineItem[]
  soPayments  SOPayment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// Append-only deposit/payment ledger. DESIGN.md v2.0 Destructive Action
// Guardrail: balanceDue is always derived (order total - sum(SOPayment.amount)),
// never a stored/manually-editable field — the SPS review corpus's "deposits
// show a negative A/R" bug is structurally impossible when there is nothing
// to desync.
model SOPayment {
  id               String     @id @default(uuid())
  salesOrderId     String
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id])
  amount           Float
  method           String? // Cash, Check, Card, Wire, Other
  note             String?
  recordedByUserId String?
  recordedByRole   String?
  createdAt        DateTime   @default(now())

  @@index([salesOrderId])
}

model SOLineItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])

  inventoryItemId String        @unique
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  soldPricePerSf   Float
  landedCostAtSale Float // Snapshotted for immutable margin

  // Fabrication line-item depth — buyer-checklist gap: "edge profiles configurable
  // per shop, with associated upcharges" / "cutout pricing rules editable in 60 seconds".
  edgeProfile        String?
  edgeUpchargePerSf  Float   @default(0)
  cutoutCount        Int     @default(0)
  cutoutUpchargeEach Float   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ---------------------------------------------------------
// Event Outbox (Handoffs)
// ---------------------------------------------------------

model EventOutbox {
  id            String    @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        String // PENDING, COMPLETED, FAILED
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  @@index([status])
}

// ---------------------------------------------------------
// Accounts Payable (Vendor Invoices)
// ---------------------------------------------------------

model VendorInvoice {
  id             String    @id @default(uuid())
  invoiceNum     String    @unique
  vendorId       String
  vendor         Party     @relation(fields: [vendorId], references: [id])
  status         String // Pending Payment, Overdue, In Dispute, Paid
  amount         Float     @default(0.0)
  dueDate        DateTime?
  serviceDetails String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([vendorId])
}

// ---------------------------------------------------------
// Company-wide visibility / security settings
// ---------------------------------------------------------

model CompanySetting {
  id                         String   @id @default(uuid())
  companyId                  String   @unique
  company                    Company  @relation(fields: [companyId], references: [id])
  salesCanViewLandedCost     Boolean  @default(false)
  salesCanViewAllPipeline    Boolean  @default(false)
  vendorCanViewFullInventory Boolean  @default(false)
  /**
   * PO estimated total ($) above which a PO requires approval before it can proceed. null = disabled.
   */
  poApprovalThreshold        Float?
  /**
   * Local-part token for the per-company reconciliation inbox, e.g. "acme-7f3a" -> po-recon+acme-7f3a@inbound.blueplanet.app
   */
  reconciliationInboxToken   String?  @unique
  updatedAt                  DateTime @updatedAt
}

// ---------------------------------------------------------
// Email-to-PO Reconciliation
// ---------------------------------------------------------

// Raw ingested message (email today; leaves room for SMS/portal-message later).
// Written before any extraction/LLM call so a crash mid-processing never loses
// the source-of-truth text.
model InboundMessage {
  id                String  @id @default(uuid())
  channel           String  @default("EMAIL")
  providerMessageId String  @unique // dedupe key from the inbound-parse provider
  fromAddress       String
  toAddress         String // the per-company forwarding address it hit
  subject           String?
  bodyText          String
  bodyHtml          String?
  rawPayload        Json // full provider payload, for replay/debugging
  attachments       Json?

  status      String    @default("RECEIVED") // RECEIVED, EXTRACTED, EXTRACTION_FAILED, IGNORED
  processedAt DateTime?

  cases ReconciliationCase[]

  createdAt DateTime @default(now())

  @@index([status])
}

// Groups the deltas produced from one InboundMessage against (at most) one PO.
model ReconciliationCase {
  id               String         @id @default(uuid())
  inboundMessageId String
  inboundMessage   InboundMessage @relation(fields: [inboundMessageId], references: [id])

  // Best-guess PO match at extraction time — nullable, since low-confidence
  // emails land unmatched and block in the UI until a human links one.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  matchMethod     String? // PO_NUMBER_IN_SUBJECT, PO_NUMBER_IN_BODY, SUPPLIER_EMAIL, MANUAL
  matchConfidence Float? // 0..1

  // Thread correlation so a supplier's follow-up correction supersedes rather
  // than stacks on the first email's still-pending deltas.
  threadKey String?

  status String                @default("NEEDS_MATCH") // NEEDS_MATCH, IN_REVIEW, BLOCKED, RESOLVED, DISMISSED
  deltas ReconciliationDelta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([purchaseOrderId])
}

// One field-level proposed change — the unit of review/approve/reject.
model ReconciliationDelta {
  id     String             @id @default(uuid())
  caseId String
  case   ReconciliationCase @relation(fields: [caseId], references: [id])

  // What this delta targets — not limited to the PO header, so a single email
  // can spawn deltas against the PO, its line items, AND already-materialized
  // InventoryItem rows in one review pass.
  entityType      String // PurchaseOrder | POLineItem | InventoryItem
  entityId        String
  purchaseOrderId String // always populated for grouping/filtering, even for InventoryItem-scoped deltas
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  field         String // e.g. orderedSlabs, unitCost, oceanCost, estimatedDelivery, costLanded
  oldValue      Json // snapshot at extraction time (detect staleness on apply)
  newValue      Json
  sourceExcerpt String? // exact quoted sentence the LLM attributed this to
  confidence    Float? // 0..1, LLM self-reported

  // True when the target PO/line was already RECEIVED (slabs materialized)
  // at extraction time — drives the "affected slabs" UI.
  retroactive Boolean @default(false)

  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, APPLIED, BLOCKED, SUPERSEDED
  blockedReason    String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  appliedAt        DateTime?

  // For qty-down/write-off deltas: which specific InventoryItem ids the
  // reviewer chose to apply the correction to (human decision, never inferred).
  affectedInventoryItemIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([purchaseOrderId, status])
}
